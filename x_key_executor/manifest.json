{
  "manifest_version": 3,
  "name": "X Key Executor",
  "version": "1.0.0",
  "description": "Runs Esc -> Shift+Tab -> Enter cycles and collects visible X media URLs.",
  "permissions": ["activeTab", "storage", "scripting"],
  "host_permissions": ["https://x.com/*", "https://twitter.com/*"],
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "X Key Executor"
  }
}
